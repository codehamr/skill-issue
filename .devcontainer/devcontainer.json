{
    "name": "skill-issue",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "remoteUser": "root",
    // Runtime for npm-based MCP tools; the agents themselves are native binaries.
    "features": {
        "ghcr.io/devcontainers/features/node:1": {
            "version": "lts"
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools"
            ],
            "settings": {
                "C_Cpp.default.compilerPath": "/usr/bin/gcc",
                "C_Cpp.default.intelliSenseMode": "linux-gcc-x64",
                "C_Cpp.default.cStandard": "c23"
            }
        }
    },
    // Keep Claude's account state and global config in its persistent directory.
    "containerEnv": {
        "CLAUDE_CONFIG_DIR": "/root/.claude"
    },
    "mounts": [
        // Private to this devcontainer; reused across rebuilds, with no login sync.
        "source=claude-code-config-${devcontainerId},target=/root/.claude,type=volume",
        "source=codex-config-${devcontainerId},target=/root/.codex,type=volume",
        "source=agent-skills-${devcontainerId},target=/root/.agents,type=volume",
        // Claude Console OAuth and Anthropic profiles use this separate directory.
        "source=anthropic-config-${devcontainerId},target=/root/.config/anthropic,type=volume",
        // Codehamr keeps .codehamr/ in the project, persisted by the workspace mount.
        // HOME on Linux/WSL, USERPROFILE on Windows. Keep the host read-only;
        // setup-ssh.sh refreshes a copy with Unix permissions at every start.
        "source=${localEnv:HOME}${localEnv:USERPROFILE}/.ssh,target=/root/.ssh-host,type=bind,readonly"
    ],
    "runArgs": [
        "--cap-add=SYS_PTRACE",
        "--security-opt",
        "seccomp=unconfined"
    ],
    "postCreateCommand": "git config --global --add safe.directory ${containerWorkspaceFolder} && mkdir -p code build && gcc --version >/dev/null && x86_64-w64-mingw32-gcc --version >/dev/null && magick -version >/dev/null && python3 --version >/dev/null && ffmpeg -version >/dev/null && ffprobe -version >/dev/null && claude --version >/dev/null && codex --version >/dev/null && codehamr --version >/dev/null && echo 'toolchain ok'",
    "postStartCommand": "sh .devcontainer/setup-ssh.sh"
}
